# Copy to the project root .env only if it does not exist; keep it private.
APP_ORIGIN=https://coach.example.com
MODEL_PROVIDER=mock
# Fill the DeepSeek key privately only when intentionally switching MODEL_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_FALLBACK_MODEL=qwen3.7-plus-2026-05-26
ENABLE_QWEN_FALLBACK=false
QWEN_MAX_OUTPUT_TOKENS=2048
DAILY_INPUT_TOKEN_LIMIT=100000
DAILY_OUTPUT_TOKEN_LIMIT=30000
DAILY_AGENT_TURN_LIMIT=50
# Compose fixes APP_MODE=invite and DATABASE_PATH=/app/data/goal-coach.db.
# Override only to a NEW volume name for a stopped-app restore; preserve the old one.
GOAL_COACH_DATA_VOLUME=goal-coach-data-v020
GOAL_COACH_IMAGE=goal-coach-agent:0.2.2
