{
  "name": "goal-coach-agent",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "24.20.x", "pnpm": "11.19.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "local:check": "node scripts/local-app.mjs check",
    "local:start": "node scripts/local-app.mjs start",
    "package:source": "node scripts/package-source.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:backup": "node scripts/database-backup.mjs",
    "db:restore": "node scripts/database-restore.mjs",
    "deployment:check": "tsx scripts/deployment-check.mjs",
    "auth:admin": "tsx scripts/auth-admin.ts",
    "eval": "tsx evals/run.ts --provider=mock",
    "eval:live": "tsx evals/run.ts --provider=qwen --max-cases=5",
    "eval:deepseek": "tsx evals/run.ts --provider=deepseek --max-cases=5",
    "verify": "eslint . && tsc --noEmit && vitest run && next build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "openai": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.0"
  }
}
